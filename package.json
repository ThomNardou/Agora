{
  "name": "agora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "dev:seed": "npm run seed && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "seed": "npx prisma db push --force-reset && npx prisma db seed",
    "db-push": "npx prisma db push --force-reset",
    "db-pull": "npx prisma db pull",
    "db-generate": "npx prisma generate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.2",
    "next": "^16.1.7",
    "prisma": "^6.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
