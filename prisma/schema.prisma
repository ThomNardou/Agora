// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model t_admins {
  admin_id Int @id @default(autoincrement())
  email String @unique
  name String
  lastName String
  password String
  sessions t_sessions[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model t_readers {
  reader_id Int @id @default(autoincrement())
  email String @unique
  consentGiven Boolean @default(false)
  consentGivenAt DateTime?
  unsubscribeToken String? @unique
  newsLetter_readers t_newsLetters_readers[]
  emails_opened t_emails_opened[]
  emails_clicked t_emails_clicked[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model t_newsLetters {
  newsLetter_id Int @id @default(autoincrement())
  name String
  body String @db.LongText
  sendAt DateTime
  newsLetter_status_fk Int
  newsLetter_status t_newsLetters_status @relation(fields: [newsLetter_status_fk], references: [status_id])
  newsLetter_readers t_newsLetters_readers[]
  emails_opened t_emails_opened[]
  emails_clicked t_emails_clicked[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model t_newsLetters_status {
  status_id Int @id @default(autoincrement())
  displayName String
  status String
  textColor String
  backgroundColor String
  newsLetters t_newsLetters[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model t_newsLetters_readers {
  newsLetter_fk Int
  reader_fk Int
  sentAt DateTime?
  newsLetter t_newsLetters @relation(fields: [newsLetter_fk], references: [newsLetter_id])
  reader t_readers @relation(fields: [reader_fk], references: [reader_id])
  @@id([newsLetter_fk, reader_fk])
}

model t_sessions {
  session_id Int      @id @default(autoincrement())
  admin_fk     Int
  token      String @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  admin       t_admins  @relation(fields: [admin_fk], references: [admin_id])
}

model t_emails_opened {
  email_opened_id Int @id @default(autoincrement())
  newsLetter_fk Int
  reader_fk Int
  openedAt DateTime @default(now())
  newsLetter t_newsLetters @relation(fields: [newsLetter_fk], references: [newsLetter_id])
  reader t_readers @relation(fields: [reader_fk], references: [reader_id])
}

model t_emails_clicked {
  email_clicked_id Int @id @default(autoincrement())
  newsLetter_fk Int
  reader_fk Int
  clickedAt DateTime @default(now())
  newsLetter t_newsLetters @relation(fields: [newsLetter_fk], references: [newsLetter_id])
  reader t_readers @relation(fields: [reader_fk], references: [reader_id])
}